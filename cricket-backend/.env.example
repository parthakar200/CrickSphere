# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:4200

# MongoDB
MONGO_URI=mongodb://localhost:27017/cricket_management
# For MongoDB Atlas, use something like:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/cricket_management

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
