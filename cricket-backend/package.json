{
  "name": "cricket-backend",
  "version": "1.0.0",
  "description": "Cricket Scoring & Tournament Management System - Backend API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seed.js",
